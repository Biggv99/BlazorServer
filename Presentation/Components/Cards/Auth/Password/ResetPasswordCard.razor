@using OptimusPrime.Core.Utils
@using OptimusPrime.Features.Contracts.Commands
@using OptimusPrime.Presentation.Components.Elements
@using OptimusPrime.Presentation.Utils.States

@inject OptimusPrime.Presentation.Utils.States.DashboardState DashboardCardState
@inject OptimusPrime.Presentation.Utils.States.JwtTimerState JwtTimerState
@inject OptimusPrime.Presentation.Utils.Storage.SessionStorage SessionStorage
@inject OptimusPrime.Presentation.Services.AuthService AuthService

<div class="service-container">
    <div class="service-switch"> <DashboardSwitch /> </div>

    <div class="service-card">
        <h2 class="service-titolo">Reset password</h2>

        <div class="service-form">
            <div class="service-field">
                <label class="service-label">Email</label>
                <input type="email" @bind="emailInput" placeholder="Inserisci la tua email..." class="service-input" />
            </div>

            <div class="service-field">
                <label class="service-label">Reset Code</label>
                <input type="text" @bind="resetCodeInput" placeholder="Insert reset code..." class="service-input" />
            </div>

            <div class="service-field">
                <label class="service-label">New Password</label>
                <input type="password" @bind="newPasswordInput" placeholder="Insert new password..." class="service-input" />
            </div>
        </div>

        <button @onclick="InviaDati" type="button" class="button">Confirm new password</button>

        @if (!string.IsNullOrEmpty(messaggioServer)) {
            <div class="service-message @(DashboardCardState.StatoRichiesta switch {
                     StatoRichiesta.Successo => "success",
                     StatoRichiesta.Fallimento => "error",
                     StatoRichiesta.Elaborazione => "processing",
                     _ => ""
                 })">
                @messaggioServer
            </div>
        }
    </div>
</div>

@code {
    private string messaggioServer = "";
    private string emailInput = "";
    private string resetCodeInput = "";
    private string newPasswordInput = "";

    // invia la email per la conferma
    private async Task InviaDati() {

        // validation check
        if (string.IsNullOrWhiteSpace(emailInput) || string.IsNullOrWhiteSpace(resetCodeInput) || string.IsNullOrWhiteSpace(newPasswordInput)) {
            DashboardCardState.SetRichiestaState(StatoRichiesta.Fallimento);
            messaggioServer = "All fields are required";
            return;
        }

        DashboardCardState.SetRichiestaState(StatoRichiesta.Elaborazione);
        messaggioServer = "Resetting password...";

        try {

            ResetPasswordCommand command = new ResetPasswordCommand {
                Email = emailInput,
                ResetCode = resetCodeInput,
                Password = newPasswordInput
            };

            Result<bool> result = await AuthService.ResetPassword(command);
            messaggioServer = result.Message;

            if (result.IsSuccess) {
                DashboardCardState.SetRichiestaState(StatoRichiesta.Successo);
                emailInput = "";

            } else {
                DashboardCardState.SetRichiestaState(StatoRichiesta.Fallimento);
            }

        } catch {
            DashboardCardState.SetRichiestaState(StatoRichiesta.Fallimento);
            messaggioServer = "Unable to contact the server";
        }
    }
}